<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ru.math.app.controllers.TextInputController"
      spacing="10" padding="15">

    <Label text="Введите уравнение:" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>

    <HBox spacing="10">
        <TextField fx:id="equationInput" promptText="Например: 3x + 5 = 0" HBox.hgrow="ALWAYS"/>
        <Button fx:id="solveButton" text="▶ Решить" styleClass="button-success"/>
        <Button fx:id="clearButton" text="🗑 Очистить" styleClass="button-danger"/>
    </HBox>

    <Label text="💡 Примеры:" style="-fx-font-size: 12px; -fx-fill: #7f8c8d;"/>
    <Label text="3x + 6 = 0" style="-fx-font-size: 12px; -fx-fill: #3498db;"/>
    <Label text="2(x + 3) - 5 = 3(x - 1) + 7" style="-fx-font-size: 12px; -fx-fill: #3498db;"/>
    <Label text="(2x + 1)/3 - (x - 2)/2 = 5" style="-fx-font-size: 12px; -fx-fill: #3498db;"/>
    <Label text="(13.4 - y)*4.3 - 20.05 = 78.05 + 6.7y" style="-fx-font-size: 12px; -fx-fill: #3498db;"/>

    <VBox.margin>
        <Insets/>
    </VBox.margin>
</VBox>
