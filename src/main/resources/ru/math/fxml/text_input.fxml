<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ru.math.controllers.TextInputController"
      spacing="10">

    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <!-- Основное поле ввода -->
    <Label text="Введите уравнение:" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>

    <HBox spacing="10">
        <TextField fx:id="equationInput" promptText="Например: 2x + (3x+1)/(2) = 0" HBox.hgrow="ALWAYS"/>
        <Button fx:id="solveButton" text="▶ Решить" styleClass="button-success"/>
        <Button fx:id="clearButton" text="🗑 Очистить" styleClass="button-danger"/>
    </HBox>

    <!-- Тетрадный вид (динамический) -->
    <VBox fx:id="equationViewContainer" spacing="5"/>
    <Label fx:id="errorLabel" text="" style="-fx-text-fill: red; -fx-font-size: 12px;" visible="false"/>
    <Label fx:id="hintLabel" text="" style="-fx-text-fill: #cc8800; -fx-font-size: 12px;" visible="false"/>

    <!-- Мини-панель дроби -->
    <VBox style="-fx-border-color: #ddd; -fx-border-radius: 5; -fx-padding: 10;" spacing="8">
        <Label text="Вставить дробь:" style="-fx-font-size: 12px; -fx-font-weight: bold;"/>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Числитель:" prefWidth="70"/>
            <TextField fx:id="numeratorField" promptText="3x+1, 1/2x, 5" HBox.hgrow="ALWAYS"/>
        </HBox>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Знаменатель:" prefWidth="70"/>
            <TextField fx:id="denominatorField" promptText="2, (x-1) — пусто = не дробь" HBox.hgrow="ALWAYS"/>
        </HBox>

        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Button fx:id="insertFractionBtn" text="➕ Вставить в уравнение" styleClass="button-success"/>
        </HBox>
    </VBox>
</VBox>