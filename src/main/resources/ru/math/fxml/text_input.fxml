<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ru.math.controllers.TextInputController"
      spacing="10">

    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <!-- Основное поле ввода -->
    <Label text="Введите уравнение:" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>

    <HBox spacing="10">
        <TextField fx:id="equationInput" promptText="Например: 19/7*x : 26/9 = 54/13 : 28/19" HBox.hgrow="ALWAYS"/>
        <Button fx:id="solveButton" text="▶ Решить" styleClass="button-success"/>
        <Button fx:id="clearButton" text="🗑 Очистить" styleClass="button-danger"/>
    </HBox>

    <!-- Тетрадный вид (динамический) -->
    <VBox fx:id="equationViewContainer" spacing="5"/>
    <Label fx:id="errorLabel" text="" style="-fx-text-fill: red; -fx-font-size: 12px;" visible="false"/>
    <Label fx:id="hintLabel" text="" style="-fx-text-fill: #cc8800; -fx-font-size: 12px;" visible="false"/>

    <!-- Нижняя панель: дробь и клавиатура, одинаковый размер -->
    <HBox spacing="10">

        <!-- Панель дроби (как в тетради: целая слева, числитель/черта/знаменатель справа) -->
        <VBox styleClass="fraction-panel" spacing="5" HBox.hgrow="ALWAYS" alignment="CENTER">
            <HBox spacing="6" alignment="CENTER">  <!-- Изменил на CENTER -->
                <!-- Целая часть слева -->
                <TextField fx:id="integerField" promptText="целая" prefWidth="50" alignment="CENTER"/>
                <!-- Дробь справа: числитель / черта / знаменатель -->
                <VBox spacing="2" alignment="CENTER">
                    <TextField fx:id="numeratorField" promptText="числ." prefWidth="200" alignment="CENTER"/>
                    <Separator focusTraversable="false" prefWidth="100"/>
                    <TextField fx:id="denominatorField" promptText="знам." prefWidth="200" alignment="CENTER"/>
                </VBox>
            </HBox>
            <Button fx:id="insertFractionBtn" text="Добавить дробь" prefWidth="200" styleClass="fraction-insert-btn" />
        </VBox>

        <!-- Клавиатура -->
        <GridPane hgap="4" vgap="4" alignment="CENTER" styleClass="calc-panel" HBox.hgrow="ALWAYS">

            <!-- Ряд 1: 7 8 9 + ( -->
            <Button text="7" onAction="#insertCalcButton" prefWidth="42" prefHeight="32" styleClass="calc-button"
                    GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <Button text="8" onAction="#insertCalcButton" prefWidth="42" prefHeight="32" styleClass="calc-button"
                    GridPane.columnIndex="1" GridPane.rowIndex="0"/>
            <Button text="9" onAction="#insertCalcButton" prefWidth="42" prefHeight="32" styleClass="calc-button"
                    GridPane.columnIndex="2" GridPane.rowIndex="0"/>
            <Button text="+" onAction="#insertCalcButton" prefWidth="42" prefHeight="32" styleClass="calc-button-op"
                    GridPane.columnIndex="3" GridPane.rowIndex="0"/>
            <Button text="(" onAction="#insertCalcButton" prefWidth="42" prefHeight="32" styleClass="calc-button"
                    GridPane.columnIndex="4" GridPane.rowIndex="0"/>

            <!-- Ряд 2: 4 5 6 - ) -->
            <Button text="4" onAction="#insertCalcButton" prefWidth="42" prefHeight="32" styleClass="calc-button"
                    GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <Button text="5" onAction="#insertCalcButton" prefWidth="42" prefHeight="32" styleClass="calc-button"
                    GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            <Button text="6" onAction="#insertCalcButton" prefWidth="42" prefHeight="32" styleClass="calc-button"
                    GridPane.columnIndex="2" GridPane.rowIndex="1"/>
            <Button text="-" onAction="#insertCalcButton" prefWidth="42" prefHeight="32" styleClass="calc-button-op"
                    GridPane.columnIndex="3" GridPane.rowIndex="1"/>
            <Button text=")" onAction="#insertCalcButton" prefWidth="42" prefHeight="32" styleClass="calc-button"
                    GridPane.columnIndex="4" GridPane.rowIndex="1"/>

            <!-- Ряд 3: 1 2 3 * . -->
            <Button text="1" onAction="#insertCalcButton" prefWidth="42" prefHeight="32" styleClass="calc-button"
                    GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <Button text="2" onAction="#insertCalcButton" prefWidth="42" prefHeight="32" styleClass="calc-button"
                    GridPane.columnIndex="1" GridPane.rowIndex="2"/>
            <Button text="3" onAction="#insertCalcButton" prefWidth="42" prefHeight="32" styleClass="calc-button"
                    GridPane.columnIndex="2" GridPane.rowIndex="2"/>
            <Button text="*" onAction="#insertCalcButton" prefWidth="42" prefHeight="32" styleClass="calc-button-op"
                    GridPane.columnIndex="3" GridPane.rowIndex="2"/>
            <Button text="." onAction="#insertCalcButton" prefWidth="42" prefHeight="32" styleClass="calc-button"
                    GridPane.columnIndex="4" GridPane.rowIndex="2"/>

            <!-- Ряд 4: 0 x y / : -->
            <Button text="0" onAction="#insertCalcButton" prefWidth="42" prefHeight="32" styleClass="calc-button"
                    GridPane.columnIndex="0" GridPane.rowIndex="3"/>
            <Button text="x" onAction="#insertCalcButton" prefWidth="42" prefHeight="32" styleClass="calc-button-var"
                    GridPane.columnIndex="1" GridPane.rowIndex="3"/>
            <Button text="y" onAction="#insertCalcButton" prefWidth="42" prefHeight="32" styleClass="calc-button-var"
                    GridPane.columnIndex="2" GridPane.rowIndex="3"/>
            <Button text="/" onAction="#insertCalcButton" prefWidth="42" prefHeight="32" styleClass="calc-button-op"
                    GridPane.columnIndex="3" GridPane.rowIndex="3"/>
            <Button text=":" onAction="#insertCalcButton" prefWidth="42" prefHeight="32" styleClass="calc-button-op"
                    GridPane.columnIndex="4" GridPane.rowIndex="3"/>

            <!-- Ряд 5: = и ⌫ одинакового размера (каждая на 2 колонки) -->
            <HBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="4"
                  GridPane.columnSpan="5" alignment="CENTER">
                <Button text="=" onAction="#insertCalcButton" prefHeight="32"
                        styleClass="calc-button-eq" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button text="⌫" onAction="#handleBackspace" prefHeight="32"
                        styleClass="calc-button-back" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            </HBox>
        </GridPane>
    </HBox>
</VBox>