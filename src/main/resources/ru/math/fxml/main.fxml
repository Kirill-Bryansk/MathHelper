<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ru.math.app.controllers.MainController"
      spacing="10" prefHeight="750.0" prefWidth="1000.0">

    <padding>
        <Insets bottom="10" left="10" right="10" top="10"/>
    </padding>

    <!-- Заголовок -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="🧮 MathHelper" styleClass="label-title"/>
        <Label text="Решение уравнений с пошаговым объяснением" styleClass="label-subtitle"/>
    </HBox>

    <!-- Вкладки -->
    <TabPane fx:id="tabPane" VBox.vgrow="ALWAYS">
        <Tab fx:id="textInputTab" text="📝 Текстовый ввод" closable="false"/>
        <Tab fx:id="constructorTab" text="🔧 Конструктор" closable="false"/>
        <Tab fx:id="historyTab" text="📜 История" closable="false"/>
    </TabPane>

    <!-- Панель решения -->
    <VBox fx:id="solutionPanel" styleClass="solution-panel" minHeight="200" VBox.vgrow="ALWAYS">
        <Label text="📐 Решение" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
    </VBox>
</VBox>
