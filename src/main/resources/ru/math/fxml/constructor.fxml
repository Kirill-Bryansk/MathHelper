<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ru.math.app.controllers.ConstructorController"
      spacing="10" padding="15">

    <Label text="🔧 Конструктор уравнений" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <Label text="⚠️ В разработке" style="-fx-font-size: 14px; -fx-fill: #e74c3c;"/>

    <!-- Здесь будет конструктор -->
    <Label text="Скоро появится возможность собирать уравнения из слагаемых"/>

    <HBox spacing="10">
        <Button text="▶ Решить" disable="true"/>
        <Button text="🗑 Очистить" disable="true"/>
    </HBox>
</VBox>
