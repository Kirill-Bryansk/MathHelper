<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ru.math.MathHelper.ui.controller.MainController"
      spacing="10">

    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <!-- ===== Заголовок ===== -->
    <Label text="🙈🙉🙊 Специально для двоишников гимназистов. Да да Арина 🐒"
           styleClass="label-title"/>

    <Separator/>

    <!-- ===== Статусная строка ===== -->
    <Label fx:id="statusLabel"
           text="Готов к работе"/>

    <!-- ===== Строка ввода ===== -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Введите уравнение:"
               styleClass="label-input"/>
        <TextField fx:id="equationInput"
                   HBox.hgrow="ALWAYS"/>
    </HBox>

    <!-- ===== Кнопки ===== -->
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="solveButton" text="🚀 Решить"/>
        <Button fx:id="clearButton" text="🧹 Очистить"/>
        <Button fx:id="historyButton" text="📋 История"/>
        <Button fx:id="exitButton" text="🚪 Выход"/>
    </HBox>

    <Separator/>

    <!-- ===== Основная область (результат + шаги) ===== -->
    <SplitPane dividerPositions="0.6" VBox.vgrow="ALWAYS">

        <!-- Левая панель: текстовый вывод -->
        <VBox spacing="5" style="-fx-padding: 5px;">
            <Label text="📝 Решение"
                   styleClass="label-section"/>
            <TextArea fx:id="resultArea"
                      VBox.vgrow="ALWAYS"
                      editable="false"
                      wrapText="true"/>
        </VBox>

        <!-- Правая панель: список шагов -->
        <VBox spacing="5" style="-fx-padding: 5px;">
            <Label text="📋 Шаги решения"
                   styleClass="label-section"/>
            <ListView fx:id="stepsView" VBox.vgrow="ALWAYS"/>
        </VBox>

    </SplitPane>

    <!-- ===== Подсказка ===== -->
    <HBox spacing="5" style="-fx-padding: 5px 0 0 0;">
        <Label text="💡 Примеры: 3x + 5 = 20  |  2x - 3 = 7  |  x + 2 = 5"
               styleClass="label-hint"/>
    </HBox>

</VBox>